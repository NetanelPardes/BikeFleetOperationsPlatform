STATION_INFORMATION_URL=https://gbfs.lyft.com/gbfs/2.3/bkn/en/station_information.json
STATION_STATUS_URL=https://gbfs.lyft.com/gbfs/2.3/bkn/en/station_status.json
VEHICLE_TYPES_URL=https://gbfs.lyft.com/gbfs/2.3/bkn/en/vehicle_types.json

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

STATION_INFORMATION_TOPIC=bike.station-information
STATION_STATUS_TOPIC=bike.station-status
VEHICLE_TYPES_TOPIC=bike.vehicle-types

MYSQL_ROOT_PASSWORD=local-root-pass
MYSQL_DATABASE=bike_fleet

MONGO_ROOT_USER=bike_admin
MONGO_ROOT_PASSWORD=local-mongo-pass

KAFKA_CONSUMER_GROUP_ID=bike-processing-group

MYSQL_CONNECTION_STRING=Server=localhost;Port=3306;Database=bike_fleet;User ID=bike_app;Password=local-app-pass;

MONGODB_CONNECTION_STRING=mongodb://bike_admin:local-mongo-pass@localhost:27017/?authSource=admin
MONGODB_DATABASE=bike_fleet
MONGODB_HISTORY_COLLECTION=station_status_history

REDIS_CONNECTION_STRING=localhost:6379